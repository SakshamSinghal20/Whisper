# SQLite works without a database service. PostgreSQL is also supported:
# DATABASE_URL=postgresql+asyncpg://whisper:password@localhost/whisper_python
DATABASE_URL=sqlite+aiosqlite:///./whisper.db

# Bitcoin Core 26+, unpruned for historical scans. Match NETWORK to the node.
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASS=password
NETWORK=regtest
INDEXER_ENABLED=true
START_HEIGHT=0
POLL_INTERVAL=5

# Optional notification endpoint. RPC catches missed blocks even without ZMQ.
ZMQ_BLOCK_SOCKET=

# Local dashboard. Set HOST=0.0.0.0 only when remote access is intended.
HOST=127.0.0.1
PORT=3000

# Same-origin by default. Use comma-separated origins if needed.
CORS_ORIGIN=

# Inclusive block count, unique prefixes, and candidate page size.
MAX_BLOCK_RANGE=1000
MAX_PREFIXES=1000
PAGE_SIZE=100
